{
  "name": "@dsh-plugin/dsh-ui-components-vue",
  "version": "0.1.0",
  "description": "基于 Arco Design Vue、采用 HeroUI 风格的 DSH Vue 组件库",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./icons": {
      "types": "./dist/vue/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "README.zh_CN.md",
    "docs/vue-coverage.md",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "preview": "vite --config docs/preview/vite.config.ts",
    "preview:build": "vite build --config docs/preview/vite.config.ts",
    "verify:arco": "node scripts/verify-arco.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run verify:arco && npm run preview:build && npm pack --dry-run",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public",
    "tag": "vue"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-ui-components.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-ui-components/tree/vue",
  "license": "MIT",
  "keywords": [
    "dsh",
    "vue",
    "arco-design",
    "components"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.59.0",
    "dayjs": "1.11.23"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.8.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.9",
    "vue": "^3.5.45",
    "vue-tsc": "^3.1.0"
  }
}
