{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/index.ts",
    "src/vue/**/*",
    "tests/vue/**/*",
    "docs/preview/*.vue",
    "docs/preview/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
